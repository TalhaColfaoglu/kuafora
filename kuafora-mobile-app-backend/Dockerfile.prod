FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_DEFAULT_TIMEOUT=100 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Daha dayanıklı apt (retry + ca-certificates)
RUN apt-get update -o Acquire::Retries=3 -o Acquire::http::Timeout=30 \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
        ca-certificates \
        cron \
    && rm -rf /var/lib/apt/lists/*

# Önce requirements.txt'i kopyala (cache için)
COPY requirements.txt /app/

# pip install'i optimize et - timeout ve retry ekle
RUN pip install --upgrade pip setuptools wheel \
    && pip install --timeout=100 --retries=3 --no-cache-dir -r requirements.txt

# Kod dosyalarını kopyala
COPY . /app/

RUN mkdir -p /app/staticfiles /app/media

COPY entrypoint.prod.sh /app/entrypoint.prod.sh
COPY cron_entrypoint.sh /app/cron_entrypoint.sh
RUN chmod +x /app/entrypoint.prod.sh /app/cron_entrypoint.sh

RUN groupadd -r django && useradd -r -g django django
RUN chown -R django:django /app
USER django

EXPOSE 8000
ENTRYPOINT ["/app/entrypoint.prod.sh"]