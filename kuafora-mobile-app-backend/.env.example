DEBUG=1
SECRET_KEY=change-me-please-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=makas
POSTGRES_USER=makas
POSTGRES_PASSWORD=makas
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SETTINGS_MODULE=config.settings

# CORS/CSRF (adjust in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# E-posta: SMTP veya Gmail API (biri yeterli)
# Gmail API: GMAIL_API_SETUP.md | SMTP: EMAIL_HOST_USER + EMAIL_HOST_PASSWORD
# -----------------------------------------------------------------------------
# Seçenek A — Gmail API (Google API ile gönderim)
# GMAIL_API_CLIENT_ID=xxxx.apps.googleusercontent.com
# GMAIL_API_CLIENT_SECRET=GOCSPX-xxxx
# GMAIL_API_REFRESH_TOKEN=1//0xxxx...
# DEFAULT_FROM_EMAIL=info@kuafora.com
# Seçenek B — SMTP (Gmail / Workspace)
# EMAIL_HOST_USER=info@kuafora.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# DEFAULT_FROM_EMAIL=info@kuafora.com
# PUBLIC_API_ORIGIN=https://api.kuafora.com
# Şifre sıfırlama linki website'ye gitsin (link kopyalama yerine tarayıcıda form)
# PASSWORD_RESET_LINK_BASE_URL=https://kuafora.com
