# Django Production Settings
DJANGO_DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-this
ALLOWED_HOSTS=api.makasapp.com,your-domain.com
CSRF_TRUSTED_ORIGINS=https://api.makasapp.com,https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-flutter-app.com,https://makasapp.com

# Database Production
POSTGRES_DB=makas_prod
POSTGRES_USER=makas_prod
POSTGRES_PASSWORD=your-strong-db-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SETTINGS_MODULE=config.settings

# SSL/Domain
DOMAIN=api.makasapp.com
EMAIL=your-email@example.com
