# DEV backend env example (do NOT commit secrets in real env files)
# Copy to: ./env/backend.dev.env on the server

DJANGO_ENV=production
DEBUG=0
SECRET_KEY=CHANGE_ME_STRONG

POSTGRES_HOST=db_dev
POSTGRES_PORT=5432
POSTGRES_USER=kuafora_dev
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=kuafora_dev

ALLOWED_HOSTS=api-dev.kuafora.com

# Email - REQUIRED for email verification + password reset emails
# Option A: Gmail SMTP (recommended for dev). See kuafora-mobile-app-backend/EMAIL_SETUP.md
PUBLIC_API_ORIGIN=https://api-dev.kuafora.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=your.gmail@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
# DEFAULT_FROM_EMAIL optional; defaults to EMAIL_HOST_USER if unset

# Option B: AWS SES SMTP (uncomment and set if using SES instead)
# EMAIL_HOST=email-smtp.eu-central-1.amazonaws.com
# EMAIL_HOST_USER=YOUR_SES_SMTP_USERNAME
# EMAIL_HOST_PASSWORD=YOUR_SES_SMTP_PASSWORD
# DEFAULT_FROM_EMAIL must be a verified identity in SES


