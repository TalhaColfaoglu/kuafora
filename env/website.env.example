# Website (kuafora-website)
DEBUG=0
SECRET_KEY=replace-with-a-strong-secret
ALLOWED_HOSTS=kuafora.com,www.kuafora.com
CSRF_TRUSTED_ORIGINS=https://kuafora.com,https://www.kuafora.com

# API (salon verileri için)
KUAFORA_API_URL=https://api.kuafora.com

# Harita (opsiyonel - MapTiler key yoksa OpenStreetMap fallback kullanılır)
# MAPTILER_API_KEY=your_maptiler_key

# Managed DB example
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
