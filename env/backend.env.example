# Backend (kuafora-mobile-app-backend) — PRODUCTION (api.kuafora.com)
DEBUG=0
SECRET_KEY=replace-with-a-strong-secret
ALLOWED_HOSTS=api.kuafora.com
CSRF_TRUSTED_ORIGINS=https://api.kuafora.com

# -----------------------------------------------------------------------------
# VERITABANI — Prod backend MUTLAKA db servisine bağlanmalı (db_dev DEĞİL)
# docker-compose.yml'de backend servisi "depends_on: db" kullanır; host adı "db".
# Yanlışlıkla POSTGRES_HOST=db_dev yaparsanız prod backend dev veritabanını kullanır.
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=kuafora_backend
POSTGRES_USER=kuafora_backend_user
POSTGRES_PASSWORD=<env/db.env ile aynı BACKEND_PASSWORD>

# Telefon numaraları şifreleme (Fernet key). Boş bırakırsanız numaralar şifresiz saklanır.
# Oluşturmak: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PHONE_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Redis Cache Configuration (for caching and sessions)
# -----------------------------------------------------------------------------
# Redis URL for Django cache backend and session storage
# Format: redis://host:port/db_number
# Production: redis://redis:6379/1
# Development: redis://redis:6379/2
REDIS_URL=redis://redis:6379/1

# -----------------------------------------------------------------------------
# Email (AWS SES SMTP) - REQUIRED for email verification + password reset emails
# -----------------------------------------------------------------------------
# API public origin — Görsel URL'leri ve e-posta linkleri bu domain ile üretilir (sonunda / yok).
# Prod: https://api.kuafora.com — Olmazsa mobil uygulamada görseller yüklenmeyebilir.
PUBLIC_API_ORIGIN=https://api.kuafora.com

# SES SMTP endpoint (region-specific), e.g. email-smtp.eu-central-1.amazonaws.com
EMAIL_HOST=email-smtp.eu-central-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# SES SMTP credentials (NOT your AWS access key)
EMAIL_HOST_USER=YOUR_SES_SMTP_USERNAME
EMAIL_HOST_PASSWORD=YOUR_SES_SMTP_PASSWORD

# Sender (must be verified in SES)
DEFAULT_FROM_EMAIL=Kuafora <noreply@kuafora.com>

# -----------------------------------------------------------------------------
# AWS S3 Configuration (for media file storage)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY_HERE
AWS_STORAGE_BUCKET_NAME=kuafora-media
AWS_S3_REGION_NAME=eu-central-1

# -----------------------------------------------------------------------------
# AWS CloudWatch Logs Configuration
# -----------------------------------------------------------------------------
# Enable CloudWatch logging (set to True to enable)
AWS_CLOUDWATCH_ENABLED=False

# CloudWatch Log Group name (will be created automatically if permissions allow)
AWS_CLOUDWATCH_LOG_GROUP_NAME=kuafora-backend

# CloudWatch Log Stream name (default: api)
AWS_CLOUDWATCH_STREAM_NAME=api

# AWS Region for CloudWatch (should match your S3 region)
AWS_CLOUDWATCH_REGION_NAME=eu-central-1

# CloudWatch Log Retention (days) - Maliyet optimizasyonu için
# Eski loglar otomatik silinir. Önerilen: 14-30 gün
# Seçenekler: 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1827, 3653
AWS_CLOUDWATCH_LOG_RETENTION_DAYS=14

# Note: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY above are used for both S3 and CloudWatch
# Make sure your IAM user has permissions for both services:
# - S3: s3:PutObject, s3:GetObject, etc.
# - CloudWatch Logs: logs:CreateLogGroup, logs:CreateLogStream, logs:PutLogEvents, logs:DescribeLogStreams, logs:PutRetentionPolicy
